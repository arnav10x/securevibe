# Copy this file to .env.local and fill in the values.
# The README has step-by-step instructions for obtaining each one.

# Supabase project URL and publishable (anon) key.
# Where: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key (server-only; never expose to the browser).
# Needed for billing (Stripe webhook/checkout) and the cleanup cron.
# Where: Supabase Dashboard -> Project Settings -> API keys -> secret keys
SUPABASE_SECRET_KEY=

# The public URL of the app. http://localhost:3000 in development,
# your production URL (e.g. https://securevibe.vercel.app) when deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (use TEST mode keys until you are ready to charge real money).
# Where: dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=
# Where: Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=
# Where: Products -> your Pro subscription -> Price -> API ID (price_...)
STRIPE_PRICE_ID=

# Optional: GitHub personal access token with NO scopes/permissions.
# Raises the GitHub API rate limit for repo lookups. Recommended in prod.
# Where: github.com/settings/tokens -> Fine-grained token, no permissions
GITHUB_TOKEN=

# Random string; protects the cleanup cron endpoint. Any long random value.
CRON_SECRET=
